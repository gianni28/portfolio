---
import { Image } from "astro:assets";
import { FaGithub, FaYoutube } from "react-icons/fa";
import { FiArrowUpRight } from "react-icons/fi";
import { projects } from "../data/projects";
import SectionHeading from "./SectionHeading.astro";

const linkIcon = { demo: FiArrowUpRight, code: FaGithub, video: FaYoutube } as const;
---

<section id="proyectos" class="container-page py-20 md:py-28">
  <SectionHeading
    eyebrow="Proyectos"
    title="Cosas que he construido"
    intro="Proyectos personales y académicos, del problema a una versión que cualquiera puede usar."
  />

  <div class="mt-14 flex flex-col gap-10 md:gap-14">
    {
      projects.map((project, i) => (
        <article
          class="grid gap-8 rounded-3xl border border-ink-800 bg-ink-900/60 p-4 sm:p-6 lg:grid-cols-[1.25fr_1fr] lg:gap-10 lg:p-8"
          aria-labelledby={`p-${project.slug}`}
          data-gallery
        >
          <div class={`flex flex-col gap-3 ${i % 2 === 1 ? "lg:order-2" : ""}`}>
            <div class="overflow-hidden rounded-2xl border border-ink-800 bg-ink-850">
              <Image
                src={project.images[0].src}
                alt={project.images[0].alt}
                widths={[480, 800, 1200]}
                sizes="(min-width: 1024px) 620px, 100vw"
                class="aspect-video h-auto w-full object-cover"
                data-gallery-main
                loading={i === 0 ? "eager" : "lazy"}
              />
            </div>
            <div class="grid grid-cols-3 gap-3" role="group" aria-label={`Capturas de ${project.title}`}>
              {project.images.map((img, idx) => (
                <button
                  type="button"
                  class="overflow-hidden rounded-xl border-2 border-transparent opacity-60 transition hover:opacity-100 aria-pressed:border-brand aria-pressed:opacity-100"
                  aria-pressed={idx === 0 ? "true" : "false"}
                  aria-label={`Ver captura ${idx + 1}: ${img.alt}`}
                  data-gallery-thumb
                >
                  <Image
                    src={img.src}
                    alt=""
                    widths={[160, 320]}
                    sizes="200px"
                    class="aspect-video h-auto w-full object-cover"
                   
                  />
                </button>
              ))}
            </div>
            {project.images.map((img) => (
              <template data-gallery-src>
                <Image src={img.src} alt={img.alt} widths={[480, 800, 1200]} sizes="(min-width: 1024px) 620px, 100vw" />
              </template>
            ))}
          </div>

          <div class="flex flex-col">
            <div class="flex flex-wrap items-center gap-3">
              <h3 id={`p-${project.slug}`} class="font-display text-2xl font-bold tracking-tight text-white sm:text-3xl">
                {project.title}
              </h3>
              {project.badge && (
                <span class="rounded-full bg-brand px-2.5 py-0.5 font-mono text-[11px] font-medium uppercase tracking-wider text-ink-950">
                  {project.badge}
                </span>
              )}
            </div>
            <p class="mt-2 text-base font-medium text-fg">{project.tagline}</p>
            <p class="mt-4 leading-relaxed text-fg-muted">{project.description}</p>

            <ul class="mt-5 space-y-2.5">
              {project.highlights.map((h) => (
                <li class="flex gap-3 text-sm leading-relaxed text-fg-muted">
                  <span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-brand" aria-hidden="true" />
                  <span>{h}</span>
                </li>
              ))}
            </ul>

            {project.note && (
              <p class="mt-5 rounded-xl border border-brand/40 bg-brand/10 px-4 py-3 text-sm leading-relaxed text-fg">
                {project.note}
              </p>
            )}

            <ul class="mt-6 flex flex-wrap gap-2" aria-label="Tecnologías">
              {project.tech.map((t) => (
                <li class="chip">{t}</li>
              ))}
            </ul>

            <div class="mt-auto flex flex-wrap gap-3 pt-7">
              {project.links.map((link, li) => {
                const Icon = linkIcon[link.kind];
                return (
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={li === 0 ? "btn-primary" : "btn-ghost"}
                  >
                    {link.kind !== "demo" && <Icon size={16} aria-hidden="true" />}
                    {link.label}
                    {link.kind === "demo" && <Icon size={16} aria-hidden="true" />}
                    <span class="sr-only"> (se abre en una pestaña nueva)</span>
                  </a>
                );
              })}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((gallery) => {
    const main = gallery.querySelector<HTMLImageElement>("[data-gallery-main]");
    const thumbs = Array.from(gallery.querySelectorAll<HTMLButtonElement>("[data-gallery-thumb]"));
    const sources = Array.from(gallery.querySelectorAll<HTMLTemplateElement>("[data-gallery-src]")).map((t) =>
      t.content.querySelector("img"),
    );
    thumbs.forEach((thumb, idx) => {
      thumb.addEventListener("click", () => {
        const src = sources[idx];
        if (!main || !src) return;
        main.src = src.src;
        main.srcset = src.srcset;
        main.alt = src.alt;
        thumbs.forEach((t) => t.setAttribute("aria-pressed", String(t === thumb)));
      });
    });
  });
</script>
