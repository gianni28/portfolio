---
import SocialLinks from "./SocialLinks.astro";
import { SITE } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-ink-800">
  <div class="container-page flex flex-col items-center justify-between gap-5 py-8 text-sm text-fg-subtle sm:flex-row">
    <p>© {year} {SITE.fullName}</p>
    <p class="order-last sm:order-none">Hecho con Astro y Tailwind CSS</p>
    <SocialLinks />
  </div>
</footer>
