---
import type { IconType } from "react-icons";
import { FaHtml5, FaCss3Alt, FaJs, FaReact, FaPython, FaJava, FaGitAlt } from "react-icons/fa";
import { RiTailwindCssFill } from "react-icons/ri";
import { IoLogoFirebase } from "react-icons/io5";
import { GrMysql } from "react-icons/gr";
import { DiMsqlServer } from "react-icons/di";
import { SiAstro, SiVercel, SiRender, SiNetlify } from "react-icons/si";
import { TbBrowserCheck } from "react-icons/tb";
import SectionHeading from "./SectionHeading.astro";

const groups: { title: string; items: { name: string; Icon: IconType; color: string }[] }[] = [
  {
    title: "Frontend",
    items: [
      { name: "HTML", Icon: FaHtml5, color: "#e34f26" },
      { name: "CSS", Icon: FaCss3Alt, color: "#2965f1" },
      { name: "JavaScript", Icon: FaJs, color: "#f7df1e" },
      { name: "React", Icon: FaReact, color: "#61dafb" },
      { name: "Astro", Icon: SiAstro, color: "#bc52ee" },
      { name: "Tailwind CSS", Icon: RiTailwindCssFill, color: "#38bdf8" },
    ],
  },
  {
    title: "Lenguajes y datos",
    items: [
      { name: "Python", Icon: FaPython, color: "#ffd43b" },
      { name: "Java", Icon: FaJava, color: "#f89820" },
      { name: "MySQL", Icon: GrMysql, color: "#6aa3d8" },
      { name: "SQL Server", Icon: DiMsqlServer, color: "#e8625a" },
      { name: "Firebase", Icon: IoLogoFirebase, color: "#ffca28" },
    ],
  },
  {
    title: "Herramientas y despliegue",
    items: [
      { name: "Git y GitHub", Icon: FaGitAlt, color: "#f05032" },
      { name: "Playwright", Icon: TbBrowserCheck, color: "#45ba4b" },
      { name: "Vercel", Icon: SiVercel, color: "#ffffff" },
      { name: "Render", Icon: SiRender, color: "#ffffff" },
      { name: "Netlify", Icon: SiNetlify, color: "#32e6e2" },
    ],
  },
];

const languages = ["Español", "Italiano", "Inglés"];
---

<section id="sobre-mi" class="container-page py-20 md:py-28">
  <div class="grid gap-12 lg:grid-cols-[1fr_1.15fr] lg:gap-16">
    <div>
      <SectionHeading eyebrow="Sobre mí" title="Me gusta que las cosas funcionen, y que se entiendan" />
      <div class="mt-6 space-y-4 leading-relaxed text-fg-muted">
        <p>
          Estoy terminando Ingeniería Informática en la Universidad de La Sabana. Disfruto el camino completo de un
          proyecto: entender el problema, escoger la solución más simple que funcione y dejarla lista para que otra
          persona la use sin manual.
        </p>
        <p>
          He trabajado en desarrollo web con React y Astro, web scraping con Python, aplicaciones de escritorio en
          Java y bases de datos como MySQL, SQL Server y Firebase. Hoy aplico eso en SLB, automatizando procesos de un
          equipo real.
        </p>
        <p>
          Fuera del código toco piano y hago covers de metal; de ahí salió Oblicua.
        </p>
      </div>

      <div class="mt-8">
        <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-fg-subtle">Idiomas</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {languages.map((l) => <li class="chip text-fg">{l}</li>)}
        </ul>
      </div>
    </div>

    <div class="grid gap-4 self-start">
      {
        groups.map((g) => (
          <div class="rounded-3xl border border-ink-800 bg-ink-900/60 p-6">
            <h3 class="font-mono text-xs uppercase tracking-[0.16em] text-fg-subtle">{g.title}</h3>
            <ul class="mt-4 flex flex-wrap gap-2">
              {g.items.map(({ name, Icon, color }) => (
                <li class="inline-flex items-center gap-2 rounded-full border border-ink-700 bg-ink-850 px-3.5 py-1.5 text-sm text-fg">
                  <Icon size={16} color={color} aria-hidden="true" />
                  {name}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
