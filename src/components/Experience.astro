---
import SectionHeading from "./SectionHeading.astro";

const items = [
  {
    period: "2026 — Actualidad",
    role: "Practicante de Ingeniería",
    org: "SLB",
    team: "Equipo HRPS · Human Resources Process Systems",
    summary:
      "Diseño y desarrollo un sistema de apoyo a la decisión que prioriza los casos de servicio que recibe el equipo y recomienda a quién asignarlos, para reducir el riesgo de incumplir los SLA y mantener equilibrada la carga de trabajo.",
    points: [
      "Lógica determinística, explicable y auditable, pensada para que el equipo entienda por qué se recomienda cada asignación.",
      "Lectura de datos mediante automatización de navegador con Playwright, dentro de las restricciones de seguridad corporativas.",
      "Levantamiento de requisitos con el equipo y la jefatura, e iteración a partir de su retroalimentación.",
    ],
    tags: ["Playwright", "Automatización", "Sistemas de apoyo a la decisión"],
  },
  {
    period: "Décimo semestre · 2026",
    role: "Ingeniería Informática",
    org: "Universidad de La Sabana",
    team: "Formación profesional",
    summary:
      "Base sólida en programación, bases de datos y resolución de problemas, con cursos como Automatización y Control de Procesos.",
    points: [
      "Proyecto de riego inteligente para cultivo de fresas: control PID, sensores con ESP32, datos IoT por MQTT y un clasificador Random Forest.",
    ],
    tags: ["IoT", "Control", "Machine Learning"],
  },
];
---

<section id="experiencia" class="border-y border-ink-800 bg-ink-900/40">
  <div class="container-page py-20 md:py-28">
    <SectionHeading eyebrow="Experiencia" title="Dónde estoy aprendiendo" />

    <ol class="mt-14 space-y-4">
      {
        items.map((item) => (
          <li class="grid gap-4 rounded-3xl border border-ink-800 bg-ink-950/60 p-6 sm:p-8 md:grid-cols-[13rem_1fr] md:gap-10">
            <div>
              <p class="font-mono text-xs uppercase tracking-[0.16em] text-fg-subtle">{item.period}</p>
              <p class="mt-3 font-display text-xl font-bold text-white">{item.org}</p>
              <p class="mt-1 text-sm text-fg-muted">{item.team}</p>
            </div>
            <div>
              <h3 class="text-lg font-medium text-white">{item.role}</h3>
              <p class="mt-3 leading-relaxed text-fg-muted">{item.summary}</p>
              <ul class="mt-4 space-y-2.5">
                {item.points.map((p) => (
                  <li class="flex gap-3 text-sm leading-relaxed text-fg-muted">
                    <span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-brand" aria-hidden="true" />
                    <span>{p}</span>
                  </li>
                ))}
              </ul>
              <ul class="mt-5 flex flex-wrap gap-2" aria-label="Temas">
                {item.tags.map((t) => (
                  <li class="chip">{t}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
