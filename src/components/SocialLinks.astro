---
import { FaGithub, FaLinkedin } from "react-icons/fa";
import { SiGmail } from "react-icons/si";
import { SITE } from "../data/site";

interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;

const items = [
  { label: "LinkedIn", href: SITE.links.linkedin, Icon: FaLinkedin, external: true },
  { label: "GitHub", href: SITE.links.github, Icon: FaGithub, external: true },
  { label: "Correo", href: `mailto:${SITE.email}`, Icon: SiGmail, external: false },
];
---

<ul class={`flex items-center gap-2 ${className}`}>
  {
    items.map(({ label, href, Icon, external }) => (
      <li>
        <a
          href={href}
          aria-label={label}
          title={label}
          {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
          class="grid h-10 w-10 place-items-center rounded-full border border-ink-700 text-fg-muted transition-colors hover:border-brand hover:text-white"
        >
          <Icon size={18} aria-hidden="true" />
        </a>
      </li>
    ))
  }
</ul>
